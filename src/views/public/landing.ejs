<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= seo?.title || (title + ' | AutoBrand AI') %></title>
    <meta name="description" content="<%= seo?.description || 'AutoBrand AI social operating system.' %>" />
    <meta name="robots" content="<%= seo?.robots || 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' %>" />
    <link rel="canonical" href="<%= seo?.canonical || '/' %>" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/assets/autobrand-icon-192.png" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="AutoBrand AI for language models" />
    <meta name="theme-color" content="#082c52" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AutoBrand AI" />
    <meta property="og:title" content="<%= seo?.title || title %>" />
    <meta property="og:description" content="<%= seo?.description || 'AutoBrand AI social operating system.' %>" />
    <meta property="og:url" content="<%= seo?.canonical || '/' %>" />
    <meta property="og:image" content="<%= seo?.image || '/assets/autobrand-og.png' %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= seo?.title || title %>" />
    <meta name="twitter:description" content="<%= seo?.description || 'AutoBrand AI social operating system.' %>" />
    <meta name="twitter:image" content="<%= seo?.image || '/assets/autobrand-og.png' %>" />
    <% for (const item of structuredData || []) { %><script type="application/ld+json" nonce="<%= cspNonce %>"><%- item %></script><% } %>
    <link rel="stylesheet" href="/css/landing.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="cursor-glow" id="cursorGlow"></div>

    <nav class="nav" id="nav" aria-label="Primary">
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label="AutoBrand AI home">
          <span class="brand-mark">AB</span>
          <span>AutoBrand AI</span>
        </a>

        <div class="nav-links" id="navLinks">
          <a href="/" data-page-link="homePage">Home</a>
          <a href="/features" data-page-link="featuresPage">Features</a>
          <a href="/pricing" data-page-link="pricingPage">Pricing</a>
          <a href="/resources" data-page-link="resourcesPage">Resources</a>
          <a href="/help" data-page-link="helpPage">Help</a>
          <div class="mobile-menu-cta">
            <button
              class="theme-toggle"
              id="mobileThemeToggle"
              type="button"
              aria-label="Toggle dark mode"
            >
              ☾
            </button>
            <a href="/auth/login" class="btn btn-ghost"
              >Login</a
            >
            <a
              href="/start/free-trial"
              class="btn btn-primary"
              >Start free</a
            >
          </div>
        </div>

        <div class="nav-actions">
          <button
            class="theme-toggle"
            id="themeToggle"
            type="button"
            aria-label="Toggle dark mode"
          >
            ☾
          </button>
          <a href="/auth/login" class="btn btn-ghost"
            >Login</a
          >
          <a href="/start/free-trial" class="btn btn-primary"
            >Start free</a
          >
        </div>

        <button
          class="mobile-toggle"
          id="mobileToggle"
          type="button"
          aria-label="Open navigation"
          aria-controls="navLinks"
          aria-expanded="false"
        >
          ☰
        </button>
      </div>
    </nav>

    <main id="main-content">
      <div class="page active" id="homePage">
        <section class="hero" id="start">
          <div class="container hero-grid">
            <div class="hero-copy reveal">
              <div class="eyebrow">
                <span class="pulse"></span> One social operating system for brands, teams and agencies
              </div>
              <h1>
                Run your brand from one <span>intelligent social workspace.</span>
              </h1>
              <p>
                Create manually, work through your own ChatGPT, or let AutoBrand AI assist and automate according to your Brand Brain. Store assets in AutoBrand, your Google Drive, or both—then approve, schedule, publish, measure and improve from one workspace.
              </p>
              <div class="hero-actions">
                <a href="/start/free-trial" class="btn btn-primary"
                  >Start free</a
                >
                <a href="#workflow" class="btn btn-ghost">See workflow</a>
              </div>
              <div class="trust-row">
                <div class="avatars" aria-hidden="true">
                  <span class="avatar">AM</span>
                  <span class="avatar">JK</span>
                  <span class="avatar">PL</span>
                  <span class="avatar">+8</span>
                </div>
                <span
                  >Designed for content creators, solo founders, marketing teams
                  and client-based agencies.</span
                >
              </div>
            </div>

            <div class="hero-visual reveal">
              <div class="floating-card one">
                <small>Publishing history</small>
                <% if (siteStats.approvalRate !== null) { %><strong><%= siteStats.approvalRate %>% published</strong><% } else { %><strong>Ready to configure</strong><% } %>
                <div class="progress"><span></span></div>
              </div>
              <div class="floating-card two">
                <small>Workspace activity</small>
                <strong><%= siteStats.generatedAssetsLabel %> assets created</strong>
                <div class="chip-row">
                  <span class="chip"><%= siteStats.totalPostsLabel %> posts</span>
                  <span class="chip"><%= siteStats.videoJobs %> videos</span>
                  <span class="chip"><%= siteStats.connectedAccounts %> accounts</span>
                </div>
              </div>

              <div class="product-card">
                <div class="app-window">
                  <div class="window-top">
                    <div class="dots">
                      <span class="dot"></span><span class="dot"></span
                      ><span class="dot"></span>
                    </div>
                    <span class="window-label"
                      >Brand workspace / Summer launch</span
                    >
                  </div>
                  <div class="landing-showcase">
                    <div class="showcase-header">
                      <span class="status-pill">AI campaign builder</span>
                      <strong>From brand brief to content plan</strong>
                    </div>

                    <div class="showcase-brief">
                      <label>Campaign brief</label>
                      <p>
                        Build a 14-day content campaign for a new streetwear
                        drop. Focus on product story, scarcity, creator videos,
                        and clear sales CTAs.
                      </p>
                    </div>

                    <div class="showcase-grid">
                      <div class="showcase-card">
                        <span>01</span>
                        <strong>Brand strategy</strong>
                        <p>Audience, positioning, offer angle and tone.</p>
                      </div>
                      <div class="showcase-card">
                        <span>02</span>
                        <strong>Content ideas</strong>
                        <p>Reels, carousels, stories and ad copy.</p>
                      </div>
                      <div class="showcase-card">
                        <span>03</span>
                        <strong>Calendar plan</strong>
                        <p>Daily publishing flow with review status.</p>
                      </div>
                      <div class="showcase-card">
                        <span>04</span>
                        <strong>Performance notes</strong>
                        <p>Track hooks, clicks, saves and conversions.</p>
                      </div>
                    </div>

                    <div class="showcase-metrics">
                      <div><strong><%= siteStats.generatedAssetsLabel %></strong><span>Assets created</span></div>
                      <div><strong><%= siteStats.campaignsLabel %></strong><span>Campaigns</span></div>
                      <div><strong><%= siteStats.scheduledPosts %></strong><span>Scheduled posts</span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section">
          <div class="container">
            <div class="section-head reveal">
              <div class="section-kicker">Built for practical marketing</div>
              <h2>Turn scattered ideas into clear campaigns.</h2>
              <p>
                Give the AI your niche, product, audience and tone. It converts
                your strategy into platform-ready content with measurable goals
                and clear next steps.
              </p>
            </div>
            <div class="stats-grid reveal">
              <div class="stat-tile">
                <strong><%= siteStats.campaignsLabel %></strong
                ><span
                  >Real campaigns currently tracked by the platform.</span
                >
              </div>
              <div class="stat-tile">
                <strong><%= siteStats.supportedPlatformCount %> networks supported</strong
                ><span
                  >Connect supported social networks based on provider permissions and your plan.</span
                >
              </div>
              <div class="stat-tile">
                <strong><%= siteStats.generatedAssetsLabel %></strong
                ><span
                  >Posts, media assets and video jobs managed in the system.</span
                >
              </div>
              <div class="stat-tile">
                <strong><%= siteStats.activeBrandsLabel %></strong
                ><span
                  >Active brand memories for voice, offers and audience rules.</span
                >
              </div>
            </div>
          </div>
        </section>

        <section class="section core-features-section" id="features">
          <div class="container">
            <div class="section-head reveal">
              <div class="section-kicker">Core features</div>
              <h2>Your clean AI agent platform for brand growth.</h2>
              <p>
                Plan content, create copy, organize brand data and prepare
                campaigns without jumping between many tools.
              </p>
            </div>

            <div class="feature-grid">
              <article class="feature-card reveal">
                <div class="icon">01</div>
                <h3>Brand Strategy Agent</h3>
                <p>
                  Generate positioning, target audience, content pillars, offer
                  angles and brand voice from a simple business description.
                </p>
                <ul class="data-list">
                  <li>Audience personas</li>
                  <li>Messaging framework</li>
                  <li>Brand voice rules</li>
                </ul>
              </article>
              <article class="feature-card reveal">
                <div class="icon">02</div>
                <h3>Content Production</h3>
                <p>
                  Create captions, hooks, carousels, reels, video scripts, email
                  ideas and ad variations for daily publishing.
                </p>
                <ul class="data-list">
                  <li>Caption sets</li>
                  <li>Script outlines</li>
                  <li>Repurposed content</li>
                </ul>
              </article>
              <article class="feature-card reveal">
                <div class="icon">03</div>
                <h3>Calendar Planning</h3>
                <p>
                  Turn campaign goals into weekly or monthly schedules with
                  formats, channels, posting focus and content status.
                </p>
                <ul class="data-list">
                  <li>Weekly plans</li>
                  <li>Post status tracking</li>
                  <li>Channel mapping</li>
                </ul>
              </article>
              <article class="feature-card reveal">
                <div class="icon">04</div>
                <h3>Brand Kit Memory</h3>
                <p>
                  Save your tone, product facts, audience, offers and creative
                  rules so each output stays consistent.
                </p>
                <ul class="data-list">
                  <li>Voice settings</li>
                  <li>Product library</li>
                  <li>Client notes</li>
                </ul>
              </article>
              <article class="feature-card reveal">
                <div class="icon">05</div>
                <h3>Ad Angle Builder</h3>
                <p>
                  Generate paid campaign angles based on pain points, benefits,
                  objections, proof and call-to-action strategy.
                </p>
                <ul class="data-list">
                  <li>Offer hooks</li>
                  <li>CTA variations</li>
                  <li>Testing ideas</li>
                </ul>
              </article>
              <article class="feature-card reveal">
                <div class="icon">06</div>
                <h3>Performance Notes</h3>
                <p>
                  Record content results and let the AI suggest what to repeat,
                  improve or stop in the next campaign cycle.
                </p>
                <ul class="data-list">
                  <li>Winning themes</li>
                  <li>Content gaps</li>
                  <li>Next actions</li>
                </ul>
              </article>
            </div>
          </div>
        </section>

        <section class="section" id="workflow">
          <div class="container workflow">
            <div class="reveal">
              <div class="section-kicker">Workflow</div>
              <h2>One simple process from brief to publishing plan.</h2>
              <div class="steps">
                <div class="step">
                  <div class="step-number">01</div>
                  <div>
                    <h3>Set brand context</h3>
                    <p>
                      Add your product, target market, brand tone, price range,
                      proof points and key offers.
                    </p>
                  </div>
                </div>
                <div class="step">
                  <div class="step-number">02</div>
                  <div>
                    <h3>Select campaign objective</h3>
                    <p>
                      Choose awareness, launch, sales, lead generation,
                      retention or community growth.
                    </p>
                  </div>
                </div>
                <div class="step">
                  <div class="step-number">03</div>
                  <div>
                    <h3>Generate, review and schedule</h3>
                    <p>
                      Review AI suggestions, edit the copy, approve the calendar
                      and export assets for publishing.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="workflow-board reveal">
              <div class="calendar-top">
                <strong>AI Content Calendar</strong>
                <span class="status-pill">Week 1 ready</span>
              </div>
              <div class="calendar-grid">
                <div class="calendar-card featured">
                  <span>Monday</span>
                  <strong>Launch teaser carousel with product close-ups</strong>
                  <div class="platforms"><b>IG</b><b>FB</b><b>LI</b></div>
                </div>
                <div class="calendar-card">
                  <span>Tuesday</span>
                  <strong>Founder story short video</strong>
                  <div class="platforms"><b>TT</b><b>YT</b></div>
                </div>
                <div class="calendar-card">
                  <span>Wednesday</span>
                  <strong>Offer breakdown and FAQ post</strong>
                  <div class="platforms"><b>IG</b><b>ADS</b></div>
                </div>
                <div class="calendar-card featured">
                  <span>Thursday</span>
                  <strong>Creator-style product demo script pack</strong>
                  <div class="platforms"><b>TT</b><b>IG</b><b>YT</b></div>
                </div>
                <div class="calendar-card">
                  <span>Friday</span>
                  <strong>Final call CTA and testimonial post</strong>
                  <div class="platforms"><b>FB</b><b>LI</b></div>
                </div>
              </div>
              <div class="insight-panel">
                <div class="insight-card">
                  <strong>18</strong><span>approved content pieces</span>
                </div>
                <div class="insight-card">
                  <strong>6</strong><span>assets waiting for review</span>
                </div>
                <div class="insight-card">
                  <strong>3</strong><span>ad tests prepared</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="pricing">
          <div class="container">
            <div class="section-head reveal">
              <div class="section-kicker">Plans & pricing</div>
              <h2>Choose the workflow first. Then choose the scale.</h2>
              <p>
                AutoBrand has two paid paths: Publish for users who bring their own text/media or connect ChatGPT, and AI plans for users who want generative AI. All public prices are shown in USD.
              </p>
            </div>

            <div class="pricing-paths reveal">
              <article class="pricing-path"><strong>1. Try it first</strong><p>Use the 7-day Free Trial. No payment is required and it does not automatically become a paid plan.</p></article>
              <article class="pricing-path"><strong>2. Publish without AI</strong><p>Choose Publish at US$10 for 1 month if you create with ChatGPT or your own tools. Connect social accounts and Google Drive, then AutoBrand handles your library, scheduling, approvals, publishing and analytics.</p></article>
              <article class="pricing-path"><strong>3. Create with AI</strong><p>Start with AI Starter at US$10 for 1 month of access, then move to Growth, Pro, Business or Agency as your team and automation needs increase.</p></article>
            </div>

            <div class="pricing-grid">
              <% (pricingPlans || []).forEach((plan) => { %>
                <article class="price-card <%= plan.isPopular ? 'popular' : '' %> reveal">
                  <div class="plan-badge"><%= plan.isPopular ? 'Most popular' : plan.familyLabel %></div>
                  <h3><%= plan.name %></h3>
                  <div class="plan-context"><span><%= plan.workflowLabel %></span><span><%= plan.aiModeLabel %></span></div>
                  <p class="plan-best-for"><strong>Best for:</strong> <%= plan.bestFor %></p>
                  <div class="price"><%= plan.recurringPriceLabel %></div>
                  <p class="plan-billing-note"><%= plan.billingSummary %></p>
                  <div class="price-actions"><a href="<%= plan.signupUrl %>" class="btn <%= plan.isPopular ? 'btn-primary' : 'btn-ghost' %>"><%= plan.isTrial ? 'Start free trial' : `Choose ${plan.name}` %></a><a href="<%= plan.viewUrl %>" class="btn btn-ghost">See limits</a></div>
                  <ul class="feature-list">
                    <li><%= plan.aiCreditsLabel %></li>
                    <% plan.featureList.slice(0, 4).forEach((feature) => { %><li><%= feature %></li><% }) %>
                  </ul>
                </article>
              <% }) %>
            </div>
            <p class="pricing-money-note"><strong>Money clarity:</strong> paid plan prices are charged in US dollars (USD) through Pesapal. One verified payment activates one access period. AutoBrand does not automatically charge the next period. Your available mobile-money/card options are shown by Pesapal; if your payment provider converts currency, its exchange rate or fees may apply.</p>
            <div class="pricing-compare-cta"><a href="/pricing" class="btn btn-primary">Compare every limit and feature</a></div>
          </div>
        </section>

        <section class="section" id="testimonials">
          <div class="container">
            <div class="section-head reveal">
              <div class="section-kicker">Results</div>
              <h2>For people who need content that feels planned.</h2>
            </div>
            <div class="testimonials">
              <article class="quote-card reveal">
                <p>
                  “The campaign brief feature helped us turn one product idea
                  into a full week of content. The outputs were organized enough
                  for my team to review quickly.”
                </p>
                <div class="person">
                  <span class="avatar">NK</span
                  ><span><b>Nadia K.</b>Fashion founder</span>
                </div>
              </article>
              <article class="quote-card reveal">
                <p>
                  “The biggest win is consistency. Every caption, script and ad
                  angle now follows the same brand direction instead of sounding
                  random.”
                </p>
                <div class="person">
                  <span class="avatar">DM</span
                  ><span><b>Daniel M.</b>Growth marketer</span>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="section">
          <div class="container">
            <div class="cta reveal">
              <div>
                <h2>Build your next campaign with a cleaner AI workflow.</h2>
                <p>
                  Turn your brand idea into social posts, scripts, ad angles and
                  a complete content calendar from one modern workspace.
                </p>
              </div>
              <a href="/start/free-trial" class="btn">Get started free</a>
            </div>
          </div>
        </section>
      </div>


      <div class="page" id="pricingPage">
        <section class="page-hero">
          <div class="container">
            <div class="page-hero-card reveal">
              <div>
                <div class="section-kicker">Plans & pricing</div>
                <h1>Pick the way you want to work before you compare limits.</h1>
                <p>
                  Free Trial lets you test AutoBrand for 7 days at US$0. Publish is the US$10-for-1-month bring-your-own-AI/creative path with ChatGPT and Google Drive connectivity. AI Starter starts at the same US$10-for-1-month price but adds generative AI; higher AI plans add larger limits and automation.
                </p>
              </div>
              <a href="/start/free-trial" class="btn btn-primary">Start 7-day trial</a>
            </div>
          </div>
        </section>
        <section class="section">
          <div class="container">
            <div class="pricing-paths reveal">
              <article class="pricing-path"><strong>Free Trial · US$0 · 7 days</strong><p>No payment. No automatic paid conversion. Best for testing the real workflow.</p></article>
              <article class="pricing-path"><strong>Publish · US$10 · 1 month access</strong><p>Bring ChatGPT or your own copy/media. AutoBrand handles asset organization, Google Drive, validation, scheduling, approvals, publishing and analytics. No automatic renewal.</p></article>
              <article class="pricing-path"><strong>AI plans · from US$10 · 1 month access</strong><p>AI Starter adds generative text/images. Growth and higher plans add the background AI Brain, approval/autopilot modes, campaigns, video and larger team limits. No automatic renewal.</p></article>
            </div>
            <div class="pricing-grid">
              <% (pricingPlans || []).forEach((plan) => { %>
                <article class="price-card <%= plan.isPopular ? 'popular' : '' %> reveal">
                  <div class="plan-badge"><%= plan.isPopular ? 'Most popular' : plan.familyLabel %></div>
                  <h3><%= plan.name %></h3>
                  <div class="plan-context"><span><%= plan.workflowLabel %></span><span><%= plan.aiModeLabel %></span></div>
                  <p class="plan-best-for"><strong>Best for:</strong> <%= plan.bestFor %></p>
                  <div class="price"><%= plan.recurringPriceLabel %></div>
                  <p class="plan-billing-note"><%= plan.billingSummary %></p>
                  <div class="limit-pills">
                    <% (plan.limitList || []).slice(0, 4).forEach((limit) => { %><span><strong><%= limit.value %></strong><%= limit.label %></span><% }) %>
                  </div>
                  <div class="price-actions"><a href="<%= plan.signupUrl %>" class="btn <%= plan.isPopular ? 'btn-primary' : 'btn-ghost' %>"><%= plan.isTrial ? 'Start free trial' : `Choose ${plan.name}` %></a><a href="<%= plan.viewUrl %>" class="btn btn-ghost">See full details</a></div>
                  <ul class="feature-list"><li><%= plan.aiCreditsLabel %></li><% plan.featureList.slice(0, 5).forEach((feature) => { %><li><%= feature %></li><% }) %></ul>
                </article>
              <% }) %>
            </div>
            <p class="pricing-money-note"><strong>Billing clarity:</strong> all prices are shown in US dollars (USD). One verified Pesapal payment buys the access period shown. AutoBrand does not automatically charge or renew the next period; pay again through Pesapal only if you want to continue. Pesapal shows available payment methods at checkout, and provider currency conversion or fees may apply.</p>
          </div>
        </section>
        <section class="section">
          <div class="container plan-compare-card reveal">
            <div class="section-kicker">Compare plans</div>
            <h2>Compare price, workflow, AI budget and every usage limit.</h2>
            <p class="pricing-money-note">AI credits are the plan's AI spending budget. AI generation counts are separate safety ceilings. A request must fit both when both limits apply. Capacity limits such as brands/accounts are concurrent; usage limits reset on the period shown.</p>
            <div class="comparison-scroll">
              <table class="plan-compare-table">
                <thead><tr><th>Limit</th><% (pricingPlans || []).forEach((plan) => { %><th><%= plan.name %></th><% }) %></tr></thead>
                <tbody>
                  <% (planComparisonRows || []).forEach((row) => { %>
                    <tr><td><%= row.label %></td><% row.values.forEach((value) => { %><td><%= value %></td><% }) %></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>


      <div class="page" id="planDetailPage">
        <section class="page-hero">
          <div class="container">
            <div class="page-hero-card reveal">
              <div>
                <div class="section-kicker">Plan details</div>
                <h1><%= selectedPlan ? selectedPlan.name : 'Plan not found' %></h1>
                <p><%= selectedPlan ? selectedPlan.description : 'This plan is not active publicly or does not exist. Compare the currently available public plans below.' %></p>
              </div>
              <a href="/pricing" class="btn btn-primary">Compare all plans</a>
            </div>
          </div>
        </section>
        <section class="section">
          <div class="container plan-detail-layout">
            <% if (selectedPlan) { %>
              <article class="plan-detail-card reveal">
                <div class="plan-badge"><%= selectedPlan.isPopular ? 'Most popular' : selectedPlan.familyLabel %></div>
                <h2><%= selectedPlan.name %></h2>
                <div class="plan-context"><span><%= selectedPlan.workflowLabel %></span><span><%= selectedPlan.aiModeLabel %></span></div>
                <p class="desc"><%= selectedPlan.description %></p>
                <p class="plan-best-for"><strong>Best for:</strong> <%= selectedPlan.bestFor %></p>
                <div class="price"><%= selectedPlan.recurringPriceLabel %></div>
                <p class="plan-billing-note"><%= selectedPlan.billingSummary %></p>
                <p class="plan-billing-note"><strong>AI budget:</strong> <%= selectedPlan.aiCreditsLabel %>. <%= selectedPlan.usageResetLabel %>.</p>
                <div class="price-actions">
                  <a href="<%= selectedPlan.signupUrl %>" class="btn btn-primary"><%= selectedPlan.isTrial ? 'Start free trial' : `Choose ${selectedPlan.name}` %></a>
                  <a href="/pricing" class="btn btn-ghost">Back to pricing</a>
                </div>
                <ul class="feature-list">
                  <% selectedPlan.featureList.forEach((feature) => { %><li><%= feature %></li><% }) %>
                </ul>
                <% if (selectedPlan.localCurrencyNote) { %><p class="pricing-money-note"><%= selectedPlan.localCurrencyNote %></p><% } %>
              </article>
              <article class="plan-compare-card reveal">
                <div class="section-kicker">Limits</div>
                <h2>What this plan includes</h2>
                <p class="desc">Capacity limits are simultaneous workspace capacity. Usage limits follow the active trial or paid access period shown; they do not reset simply because the calendar month changes.</p>
                <div class="limit-pills">
                  <% selectedPlan.limitList.forEach((limit) => { %><span><strong><%= limit.value %></strong><%= limit.label %><small><%= limit.type === 'period' ? selectedPlan.usageResetLabel : (limit.type === 'capacity' ? 'Capacity' : 'Storage capacity') %></small></span><% }) %>
                </div>
                <div class="section-kicker">Plan comparison</div>
                <div class="comparison-scroll">
                  <table class="plan-compare-table">
                    <thead><tr><th>Limit</th><% (pricingPlans || []).forEach((plan) => { %><th><%= plan.name %></th><% }) %></tr></thead>
                    <tbody>
                      <% (planComparisonRows || []).forEach((row) => { %>
                        <tr><td><%= row.label %></td><% row.values.forEach((value) => { %><td><%= value %></td><% }) %></tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </article>
            <% } else { %>
              <article class="plan-compare-card reveal" style="grid-column:1 / -1;">
                <h2>Available plans</h2>
                <p class="desc">Pick an active public plan from the live pricing records.</p>
                <div class="pricing-grid">
                  <% (pricingPlans || []).forEach((plan) => { %><article class="price-card"><h3><%= plan.name %></h3><div class="price"><%= plan.priceLabel %></div><a class="btn btn-ghost" href="<%= plan.viewUrl %>">View details</a></article><% }) %>
                </div>
              </article>
            <% } %>
          </div>
        </section>
      </div>









