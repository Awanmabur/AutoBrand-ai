    <script nonce="<%= cspNonce %>">
      const savedTheme = localStorage.getItem("classicAutobrandTheme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
        document.body.classList.add("dark-mode");
      }

      function syncThemeIcons() {
        const isDark = document.body.classList.contains("dark-mode");
        document.querySelectorAll(".theme-toggle").forEach((button) => {
          button.textContent = isDark ? "☀" : "☾";
          button.setAttribute(
            "aria-label",
            isDark ? "Switch to light mode" : "Switch to dark mode",
          );
        });
      }

      function toggleTheme() {
        document.body.classList.toggle("dark-mode");
        localStorage.setItem(
          "classicAutobrandTheme",
          document.body.classList.contains("dark-mode") ? "dark" : "light",
        );
        syncThemeIcons();
      }

      document.querySelectorAll(".theme-toggle").forEach((button) => {
        button.addEventListener("click", toggleTheme);
      });

      syncThemeIcons();

      const cursorGlow = document.getElementById("cursorGlow");

      window.addEventListener("mousemove", (event) => {
        cursorGlow.style.left = `${event.clientX}px`;
        cursorGlow.style.top = `${event.clientY}px`;
      });

      window.addEventListener("mouseleave", () => {
        cursorGlow.style.opacity = "0";
      });

      window.addEventListener("mouseenter", () => {
        cursorGlow.style.opacity = "1";
      });

      const pages = document.querySelectorAll(".page");
      const initialPublicPage = "<%= initialPublicPage || 'homePage' %>";

      function showPage(pageId) {
        pages.forEach((page) => page.classList.remove("active"));
        const targetPage = document.getElementById(pageId);

        if (targetPage) {
          targetPage.classList.add("active");
          document.body.dataset.currentPage = pageId;
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      }

      function pageFromHash() {
        const map = {
          "#home": "homePage",
          "#features": "featuresPage",
          "#pricing": "pricingPage",
          "#resources": "resourcesPage",
          "#contact": "contactPage",
          "#about": "aboutPage",
          "#blog": "blogPage",
          "#help": "helpPage",
          "#templates": "templatesPage",
          "#integrations": "integrationsPage",
          "#privacy": "privacyPage",
          "#terms": "termsPage",
        };
        return map[window.location.hash] || initialPublicPage || "homePage";
      }

      document.querySelectorAll("[data-page-link]").forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");
          if (href && href.startsWith("/")) return;
          event.preventDefault();
          event.stopImmediatePropagation();

          const pageId = link.dataset.pageLink;

          if (href) {
            history.pushState(null, "", href);
          }

          showPage(pageId);

          nav?.classList.remove("open");
          if (mobileToggle) mobileToggle.textContent = "☰";
        });
      });

      window.addEventListener("popstate", () => showPage(pageFromHash()));
      showPage(pageFromHash());

      const nav = document.getElementById("nav");
      const mobileToggle = document.getElementById("mobileToggle");
      const navLinks = document.getElementById("navLinks");

      mobileToggle.addEventListener("click", () => {
        nav.classList.toggle("open");
        const isOpen = nav.classList.contains("open");
        mobileToggle.textContent = isOpen ? "✕" : "☰";
        mobileToggle.setAttribute("aria-expanded", String(isOpen));
        mobileToggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      });

      navLinks.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (link.dataset.pageLink) return;

          const targetId = link.getAttribute("href");

          if (targetId && targetId.startsWith("#") && targetId.length > 1) {
            const targetSection = document.querySelector(targetId);

            if (targetSection) {
              event.preventDefault();

              const navBottom = nav.getBoundingClientRect().bottom;
              const gap = 2;
              const targetTop =
                targetSection.getBoundingClientRect().top +
                window.pageYOffset -
                navBottom -
                gap;

              window.scrollTo({
                top: targetTop,
                behavior: "smooth",
              });
            }
          }

          nav.classList.remove("open");
          mobileToggle.textContent = "☰";
          mobileToggle.setAttribute("aria-expanded", "false");
          mobileToggle.setAttribute("aria-label", "Open navigation");
        });
      });

      const revealElements = document.querySelectorAll(".reveal");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );

      revealElements.forEach((element, index) => {
        element.style.transitionDelay = `${Math.min(index * 35, 220)}ms`;
        observer.observe(element);
      });

      const productCard = document.querySelector(".product-card");

      if (window.matchMedia("(min-width: 981px)").matches) {
        productCard.addEventListener("mousemove", (event) => {
          const rect = productCard.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;
          const rotateY = (x / rect.width - 0.5) * 8;
          const rotateX = (0.5 - y / rect.height) * 8;
          productCard.style.transform = `perspective(1100px) rotateY(${rotateY}deg) rotateX(${rotateX}deg) translateY(-7px)`;
        });

        productCard.addEventListener("mouseleave", () => {
          productCard.style.transform =
            "perspective(1100px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      }
    </script>
    <script defer src="/js/public-shell.js"></script>
  </body>
