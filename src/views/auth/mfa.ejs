<div class="section-kicker">Security verification</div>
<h1>Confirm this privileged sign-in.</h1>
<p>We sent a one-time code to your verified account email. Enter it to continue. The code expires shortly and can only be used once.</p>
<% if (error) { %><p class="form-error"><%= error %></p><% } %>
<form action="/auth/mfa" method="post" class="auth-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="6-digit code" aria-label="One-time verification code" required autofocus>
  <button class="btn btn-primary" type="submit">Verify and continue</button>
</form>
<div class="auth-switch">Code expired? <a href="/auth/login">Sign in again</a>.</div>
